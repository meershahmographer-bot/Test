	"scripts": {
		"97567862-a548-4b88-b3d8-fcc91eee4d96": [
			{
				"name": "Movement",
				"source": "// Set once, e.g. right after creating the camera\ncamera.rotation.order = 'YXZ';\n\n// ============================\n// MOVEMENT\n// ============================\nlet moveForward = false;\nlet moveBackward = false;\nlet moveLeft = false;\nlet moveRight = false;\nconst speed = 0.03;\n\n// ============================\n// MOUSE ROTATION\n// ============================\nlet mouseDown = false;\nlet previousMouseX = 0;\nlet previousMouseY = 0;\nconst mouseSensitivity = 0.005;\n\n// ============================\n// COLLISION\n// ============================\nconst raycaster = new THREE.Raycaster();\nconst collisionBuffer = 0.5; // how close is \"too close\" to a wall\n\nfunction getCollidables() {\n    const objects = [];\n    scene.traverse((obj) => {\n        if (obj.userData && obj.userData.collidable) objects.push(obj);\n    });\n    return objects;\n}\n\nfunction canMove(direction, distance) {\n    raycaster.set(camera.position, direction);\n    const hits = raycaster.intersectObjects(getCollidables(), true);\n    if (hits.length === 0) return true;\n    return hits[0].distance > distance + collisionBuffer;\n}\n\n// ============================\n// KEYBOARD\n// ============================\nfunction keydown(event) {\n    if (event.code === 'KeyW') moveForward = true;\n    if (event.code === 'KeyS') moveBackward = true;\n    if (event.code === 'KeyA') moveLeft = true;\n    if (event.code === 'KeyD') moveRight = true;\n}\nfunction keyup(event) {\n    if (event.code === 'KeyW') moveForward = false;\n    if (event.code === 'KeyS') moveBackward = false;\n    if (event.code === 'KeyA') moveLeft = false;\n    if (event.code === 'KeyD') moveRight = false;\n}\n\n// ============================\n// MOUSE DOWN\n// ============================\nfunction pointerdown(event) {\n    mouseDown = true;\n    previousMouseX = event.clientX;\n    previousMouseY = event.clientY;\n}\n\n// ============================\n// MOUSE UP\n// ============================\nfunction pointerup(event) {\n    mouseDown = false;\n}\n\n// ============================\n// MOUSE MOVE\n// ============================\nfunction pointermove(event) {\n    if (!mouseDown) return;\n    const movementX = event.clientX - previousMouseX;\n    const movementY = event.clientY - previousMouseY;\n    camera.rotation.y -= movementX * mouseSensitivity;\n    camera.rotation.x -= movementY * mouseSensitivity;\n    camera.rotation.x = Math.max(-Math.PI / 2, Math.min(Math.PI / 2, camera.rotation.x));\n    previousMouseX = event.clientX;\n    previousMouseY = event.clientY;\n}\n\n// ============================\n// UPDATE\n// ============================\nconst forward = new THREE.Vector3();\nconst right = new THREE.Vector3();\n\nfunction update(event) {\n    forward.set(-Math.sin(camera.rotation.y), 0, -Math.cos(camera.rotation.y));\n    right.set(-forward.z, 0, forward.x);\n\n    if (moveForward && canMove(forward, speed)) {\n        camera.position.addScaledVector(forward, speed);\n    }\n    if (moveBackward) {\n        const back = forward.clone().negate();\n        if (canMove(back, speed)) camera.position.addScaledVector(back, speed);\n    }\n    if (moveLeft) {\n        const left = right.clone().negate();\n        if (canMove(left, speed)) camera.position.addScaledVector(left, speed);\n    }\n    if (moveRight && canMove(right, speed)) {\n        camera.position.addScaledVector(right, speed);\n    }\n}"
			}],
		"dd37cbc9-b963-4e0a-a3e9-885541d427e8": [
			{
				"name": "collide",
				"source": "function update( event ) {}"
			}],
		"a6937bfa-dd04-4028-82ab-581abe20e482": [
			{
				"name": "video",
				"source": "let video, videoTexture, imageTexture, isPlaying = false;\nlet fileInput;\n\nfunction init() {\n\n\timageTexture = this.material.map;\n\n\tvideo = document.createElement( 'video' );\n\tvideo.crossOrigin = 'anonymous';\n\tvideo.loop = false;\n\tvideo.playsInline = true;\n\n\tvideoTexture = new THREE.VideoTexture( video );\n\tvideoTexture.colorSpace = THREE.SRGBColorSpace;\n\n\t// hidden file input to let you pick a video from your computer\n\tfileInput = document.createElement( 'input' );\n\tfileInput.type = 'file';\n\tfileInput.accept = 'video/*';\n\tfileInput.style.display = 'none';\n\tdocument.body.appendChild( fileInput );\n\n\tfileInput.addEventListener( 'change', function ( e ) {\n\n\t\tconst file = e.target.files[ 0 ];\n\t\tif ( file ) {\n\n\t\t\tvideo.src = URL.createObjectURL( file );\n\t\t\tvideo.load();\n\n\t\t}\n\n\t} );\n\n}\n\nfunction pointerdown( event ) {\n\n\tconst raycaster = new THREE.Raycaster();\n\tconst pointer = new THREE.Vector2();\n\tconst rect = renderer.domElement.getBoundingClientRect();\n\tpointer.x = ( ( event.clientX - rect.left ) / rect.width ) * 2 - 1;\n\tpointer.y = - ( ( event.clientY - rect.top ) / rect.height ) * 2 + 1;\n\n\traycaster.setFromCamera( pointer, camera );\n\tconst intersects = raycaster.intersectObject( this, true );\n\n\tif ( intersects.length === 0 ) return;\n\n\tif ( ! video.src ) {\n\n\t\t// first click: open the file picker so you can choose the video\n\t\tfileInput.click();\n\n\t\tvideo.addEventListener( 'canplay', function onReady() {\n\n\t\t\tthis.material.map = videoTexture;\n\t\t\tthis.material.needsUpdate = true;\n\t\t\tvideo.play();\n\t\t\tisPlaying = true;\n\t\t\tvideo.removeEventListener( 'canplay', onReady );\n\n\t\t}.bind( this ) );\n\n\t} else if ( ! isPlaying ) {\n\n\t\tvideo.play();\n\t\tisPlaying = true;\n\n\t}\n\n}\n\nfunction update( event ) {\n\n\tif ( isPlaying && video.ended ) {\n\n\t\tthis.material.map = imageTexture;\n\t\tthis.material.needsUpdate = true;\n\t\tisPlaying = false;\n\n\t}\n\n}"
			}],
